{
    "_schemaVersion": "1.0.0",

    "noiseXu":
    {
        "inputs":
        [
            {"name":"N", "kind":"required", "type":["numeric", "positive", "integer", "scalar"]},
            {"name":"alpha", "kind":"required", "type":["numeric", "scalar"]},
            {"name":"amplitude", "kind":"ordered", "type":["numeric", ">=0", "scalar"]},
            {"name":"fs", "kind":"ordered", "type":["numeric", "positive", "scalar"]},
            {"name":"Phi", "kind":"namevalue", "type":["numeric", "scalar"]}
        ],
        "outputs":
        [
            {"name":"noise", "type":["double", "column"]}
        ]
    },

    "shapeNoise":
    {
        "inputs":
        [
            {"name":"resid", "kind":"required", "type":["numeric", "column"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"alpha", "kind":"required", "type":["numeric", "scalar"]},
            {"name":"PhaseSource", "kind":"namevalue", "type":[["choices={'xu','white','pinknoise','dsp'}"], "function_handle"]},
            {"name":"Prewhiten", "kind":"namevalue", "type":[["choices={'auto'}"], ["numeric", "integer", "scalar", ">=0", "<=3"]]}
        ],
        "outputs":
        [
            {"name":"n", "type":["double", "column"]}
        ]
    },

    "estimateIRASA":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "column"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fLow", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fHigh", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"Hset", "kind":"namevalue", "type":["numeric", "vector"]},
            {"name":"CompareFieldTrip", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"ComparePMTM", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"PSD", "kind":"namevalue", "type":["choices={'pmtm','welch'}"]},
            {"name":"Prewhiten", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=0", "<=3"]},
            {"name":"Resampling", "kind":"namevalue", "type":["choices={'irasa','legacy'}"]}
        ],
        "outputs":
        [
            {"name":"alphaEst", "type":["double", "scalar"]},
            {"name":"sigmaEst", "type":["double", "scalar"]},
            {"name":"pFractal", "type":["double", "column"]},
            {"name":"fVec", "type":["double", "column"]},
            {"name":"ftInfo", "type":["struct", "scalar"]},
            {"name":"pmInfo", "type":["struct", "scalar"]}
        ]
    },

    "estimateWhittleAlpha":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "vector"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fLow", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fHigh", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"K", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=0"]},
            {"name":"DFAOrder", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=1"]},
            {"name":"MaxK", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=0"]},
            {"name":"AlphaBounds", "kind":"namevalue", "type":["numeric", "vector", "numel=2"]}
        ],
        "outputs":
        [
            {"name":"alphaEst", "type":["double", "scalar"]},
            {"name":"kUsed", "type":["double", "scalar"]},
            {"name":"info", "type":["struct", "scalar"]}
        ]
    },

    "checkSpectralKnee":
    {
        "inputs":
        [
            {"name":"resid", "kind":"required", "type":["numeric", "column"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"FitBandLow", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"WideBandLow", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"FitBandHigh", "kind":"namevalue", "type":["numeric", ">=0", "scalar"]},
            {"name":"Hset", "kind":"namevalue", "type":["numeric", "vector"]},
            {"name":"ExtraKneeStarts", "kind":"namevalue", "type":["numeric", "vector"]},
            {"name":"Resampling", "kind":"namevalue", "type":["choices={'irasa','legacy'}"]}
        ],
        "outputs":
        [
            {"name":"result", "type":["struct", "scalar"]}
        ]
    }
}
