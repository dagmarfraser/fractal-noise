{
    "_schemaVersion": "1.0.0",

    "summariseShapeNoiseBatch":
    {
        "inputs":
        [
            {"name":"infos", "kind":"required", "type":[["cell"], ["struct"]]},
            {"name":"Standard", "kind":"namevalue", "type":["numeric", "scalar", ">0", "<1"]},
            {"name":"Level", "kind":"namevalue", "type":["numeric", "scalar", ">0", "<1"]},
            {"name":"MinChannels", "kind":"namevalue", "type":["numeric", "positive", "integer", "scalar"]}
        ],
        "outputs":
        [
            {"name":"S", "type":["struct", "scalar"]}
        ]
    },

    "noiseXu":
    {
        "inputs":
        [
            {"name":"N", "kind":"required", "type":["numeric", "positive", "integer", "scalar"]},
            {"name":"alpha", "kind":"required", "type":["numeric", "scalar"]},
            {"name":"amplitude", "kind":"ordered", "type":["numeric", ">=0", "scalar"]},
            {"name":"fs", "kind":"ordered", "type":["numeric", "positive", "scalar"]},
            {"name":"Phi", "kind":"namevalue", "type":["numeric", "scalar"]}
        ],
        "outputs":
        [
            {"name":"noise", "type":["double", "column"]}
        ]
    },

    "harmonicContent":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "2d"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"f0", "kind":"required", "type":["numeric"]},
            {"name":"F0Band", "kind":"namevalue", "type":["numeric", "numel=2"]},
            {"name":"Cut", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"Kmax", "kind":"namevalue", "type":["numeric", "positive", "integer", "scalar"]}
        ],
        "outputs":
        [
            {"name":"K", "type":["double", "scalar"]},
            {"name":"info", "type":["struct", "scalar"]}
        ]
    },

    "harmonicTemplate":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "2d"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"f0", "kind":"required", "type":["numeric"]},
            {"name":"K", "kind":"required", "type":["numeric", "positive", "integer", "scalar"]},
            {"name":"F0Band", "kind":"namevalue", "type":["numeric", "numel=2"]},
            {"name":"Window", "kind":"namevalue", "type":["numeric", ">=2", "scalar"]},
            {"name":"EndAnchored", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"Trend", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"Crop", "kind":"namevalue", "type":["logical", "scalar"]}
        ],
        "outputs":
        [
            {"name":"resid", "type":["double", "2d"]},
            {"name":"fit", "type":["double", "2d"]},
            {"name":"info", "type":["struct", "scalar"]}
        ]
    },

    "shapeNoiseWrapper":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "2d"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"F0", "kind":"namevalue", "type":["numeric"]},
            {"name":"F0Band", "kind":"namevalue", "type":["numeric", "numel=2"]},
            {"name":"K", "kind":"namevalue", "type":["numeric", "positive", "integer", "scalar"]},
            {"name":"Window", "kind":"namevalue", "type":["numeric", ">=2", "scalar"]},
            {"name":"Alpha", "kind":"namevalue", "type":["numeric", "row"]},
            {"name":"AlphaBand", "kind":"namevalue", "type":[["numeric", "numel=2"], ["choices={'kinematic'}"]]},
            {"name":"ShapeArgs", "kind":"namevalue", "type":["cell"]}
        ],
        "outputs":
        [
            {"name":"n", "type":["double", "2d"]},
            {"name":"info", "type":["struct", "scalar"]}
        ]
    },

    "cetNoiseWrapper":
    {
        "inputs":
        [
            {"name":"FirstYear", "kind":"namevalue", "type":["numeric", "integer", "scalar"]},
            {"name":"LastYear", "kind":"namevalue", "type":["numeric"]},
            {"name":"K", "kind":"namevalue", "type":["numeric", "positive", "integer", "scalar"]},
            {"name":"Window", "kind":"namevalue", "type":["numeric", ">=2", "scalar"]},
            {"name":"AlphaBand", "kind":"namevalue", "type":["numeric", "numel=2"]},
            {"name":"File", "kind":"namevalue", "type":["char", "string"]},
            {"name":"LoadOnly", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"ShapeArgs", "kind":"namevalue", "type":["cell"]}
        ],
        "outputs":
        [
            {"name":"n"},
            {"name":"info"}
        ]
    },

    "shapeNoise":
    {
        "inputs":
        [
            {"name":"resid", "kind":"required", "type":["numeric", "2d"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"alpha", "kind":"ordered", "type":["numeric", "row"]},
            {"name":"Method", "kind":"namevalue", "type":["choices={'endMatched','legacy'}"]},
            {"name":"AlphaTol", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"MaxDraw", "kind":"namevalue", "type":["numeric", "integer", "positive", "scalar"]},
            {"name":"SegmentRule", "kind":"namevalue", "type":["choices={'detect','budget','tol'}"]},
            {"name":"SegmentBudget", "kind":"namevalue", "type":["numeric", "positive", "scalar", "<1"]},
            {"name":"FairShareTol", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"MinLength", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=5"]},
            {"name":"AlphaBand", "kind":"namevalue", "type":[["numeric", "numel=2"], ["choices={'kinematic'}"]]},
            {"name":"CheckUncovered", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"PhaseSource", "kind":"namevalue", "type":[["choices={'xu','white','pinknoise','dsp'}"], "function_handle"]}
        ],
        "outputs":
        [
            {"name":"n", "type":["double", "2d"]},
            {"name":"info", "type":["struct", "scalar"]}
        ]
    },

    "estimateIRASA":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "column"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fLow", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fHigh", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"Hset", "kind":"namevalue", "type":["numeric", "vector"]},
            {"name":"CompareFieldTrip", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"ComparePMTM", "kind":"namevalue", "type":["logical", "scalar"]},
            {"name":"PSD", "kind":"namevalue", "type":["choices={'pmtm','welch'}"]},
            {"name":"Prewhiten", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=0", "<=3"]},
            {"name":"Resampling", "kind":"namevalue", "type":["choices={'irasa','legacy'}"]}
        ],
        "outputs":
        [
            {"name":"alphaEst", "type":["double", "scalar"]},
            {"name":"sigmaEst", "type":["double", "scalar"]},
            {"name":"pFractal", "type":["double", "column"]},
            {"name":"fVec", "type":["double", "column"]},
            {"name":"ftInfo", "type":["struct", "scalar"]},
            {"name":"pmInfo", "type":["struct", "scalar"]}
        ]
    },

    "estimateWhittleAlpha":
    {
        "inputs":
        [
            {"name":"x", "kind":"required", "type":["numeric", "vector"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fLow", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"fHigh", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"K", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=0"]},
            {"name":"DFAOrder", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=1"]},
            {"name":"MaxK", "kind":"namevalue", "type":["numeric", "integer", "scalar", ">=0"]},
            {"name":"AlphaBounds", "kind":"namevalue", "type":["numeric", "vector", "numel=2"]}
        ],
        "outputs":
        [
            {"name":"alphaEst", "type":["double", "scalar"]},
            {"name":"kUsed", "type":["double", "scalar"]},
            {"name":"info", "type":["struct", "scalar"]}
        ]
    },

    "checkSpectralKnee":
    {
        "inputs":
        [
            {"name":"resid", "kind":"required", "type":["numeric", "column"]},
            {"name":"fs", "kind":"required", "type":["numeric", "positive", "scalar"]},
            {"name":"FitBandLow", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"WideBandLow", "kind":"namevalue", "type":["numeric", "positive", "scalar"]},
            {"name":"FitBandHigh", "kind":"namevalue", "type":["numeric", ">=0", "scalar"]},
            {"name":"Hset", "kind":"namevalue", "type":["numeric", "vector"]},
            {"name":"ExtraKneeStarts", "kind":"namevalue", "type":["numeric", "vector"]},
            {"name":"Resampling", "kind":"namevalue", "type":["choices={'irasa','legacy'}"]}
        ],
        "outputs":
        [
            {"name":"result", "type":["struct", "scalar"]}
        ]
    }
}
